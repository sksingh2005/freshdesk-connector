# Copy to .env and fill in. Never commit .env.
# Subdomain only, e.g. acme for https://acme.freshdesk.com
FRESHDESK_DOMAIN=
# API key from Freshdesk Profile Settings -> View API Key
FRESHDESK_API_KEY=
# Optional override for tests / local mock (e.g. http://127.0.0.1:PORT/api/v2)
# FRESHDESK_BASE_URL=
# Optional tuning (defaults shown)
# REQUEST_TIMEOUT_MS=10000
# MAX_RETRIES=4
